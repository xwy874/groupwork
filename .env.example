# SJTU OpenAI-compatible gateway
LLM_BASE_URL=https://models.sjtu.edu.cn/api/v1
LLM_API_KEY=sk-Jy5_QXGOOSkpR_NZelw4ww

# --- request behavior ---
LLM_TIMEOUT=30                  # per-request hard timeout (seconds) — circuit breaker
LLM_MAX_RETRIES=5               # exponential-backoff attempts on 429/5xx/timeouts
LLM_DEFAULT_TEMPERATURE=0.7
LLM_MAX_TOKENS_DEFAULT=512      # default if caller doesn't pass max_tokens
LLM_MAX_TOKENS_HARD_CAP=2048    # absolute ceiling — runaway-output protection

# --- concurrency (sized for 12-player Werewolf) ---
LLM_MAX_CONCURRENCY=10              # global in-flight cap (12 day-vote calls -> 2 queue)
LLM_MAX_CONCURRENCY_PER_MODEL=6     # per-model cap (8 Qwen agents shouldn't all fire at once)

# --- context manager (Day 10-12) ---
LLM_CTX_KEEP_TURNS=3                # 12-player games run longer; 3 turns verbatim
LLM_CTX_SUMMARY_MODEL=minimax-m2.7  # cheap model used to compress older history

# --- observability (for 成员4 trust analysis) ---
LLM_LOG_DIR=./logs                  # JSONL per-call log destination

# --- role -> model overrides (optional; defaults live in config.py) ---
# MODEL_VILLAGER=minimax-m2.7
# MODEL_WEREWOLF=qwen3.5-27b
